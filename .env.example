# --- Banco (Supabase session pooler, porta 5432) ---
DB_HOST=aws-0-<regiao>.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.<project-ref>
DB_PASS=
DB_NAME=postgres

# --- Auth / app ---
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
PORT=3333
APP_URL=http://localhost:8080

# --- Supabase Storage (uploads) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=uploads

# --- E-mail (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=RatHole <no-reply@rathole.com.br>

# --- Radar (serviço externo que envia notícias em POST /radar/items) ---
# Token de serviço enviado no header x-radar-token. Gere com: openssl rand -hex 32
RADAR_TOKEN=
# Quantos itens de cada rodada diária vão direto para o Radar dos membros (0 desliga)
RADAR_AUTO_PUBLISH=10
# URL da API usada por `npm run radar:import` (ponte Obsidian -> /radar/items). Default: http://localhost:3333
# RADAR_API_URL=http://localhost:3333

# --- OSINT (ponte /osint -> API do ratosint) ---
# Em dev dá para usar o ratosint local (`ratosint serve`, aberto em 127.0.0.1): aí o token pode ser qualquer valor, mas não vazio.
RATOSINT_URL=http://127.0.0.1:8765
# Em produção, o mesmo RATOSINT_API_TOKEN configurado no serviço ratosint.
RATOSINT_API_TOKEN=
